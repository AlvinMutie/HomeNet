# HomeNet Manager Configuration
# Copy this file to .env and adjust as necessary for your environment.

# Server settings
HOST=127.0.0.1
PORT=8000
DEBUG=false

# Allowed CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.100.7:5173

# Router Configuration (Huawei HG8145V6 Safaricom Gateway)
ROUTER_IP=192.168.100.1
ROUTER_PORT=443
ROUTER_PROTOCOL=https

# Local Network Configuration
NETWORK_INTERFACE=wlan0
NETWORK_SUBNET=192.168.100.0/24

# Discovery Settings
SCAN_TIMEOUT_SECONDS=2.5
MAX_SCAN_WORKERS=40
INTERNET_CHECK_HOST=1.1.1.1

# SQLite Database storage
DATABASE_PATH=data/homenet.db
